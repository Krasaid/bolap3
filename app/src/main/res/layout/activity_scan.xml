<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ProgressBar
        android:id="@+id/progressScan"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvScanTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/scan_title"
        android:textColor="@color/app_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvScanSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/scan_subtitle_default"
        android:textColor="@color/app_text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvScanCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancelScan"
        style="@style/SecondaryButton"
        android:layout_marginTop="38dp"
        android:text="@string/action_cancel" />

</LinearLayout>
