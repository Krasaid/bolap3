<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLibraryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/library_title"
                android:textColor="@color/app_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/IconButton"
                android:contentDescription="@string/library_settings"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <!-- Replaces the title row while songs are selected. -->
        <LinearLayout
            android:id="@+id/selectionTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelectionClose"
                style="@style/IconButton"
                android:contentDescription="@string/selection_close"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/app_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSelectAll"
                style="@style/IconButton"
                android:contentDescription="@string/selection_select_all"
                android:src="@drawable/ic_select_all" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints=""
                android:background="@drawable/bg_search_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/app_text_tertiary"
                android:hint="@string/library_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="48dp"
                android:singleLine="true"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_tertiary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/library_clear_search"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/app_text_secondary" />

        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabHome"
                    style="@style/LibraryTabActive"
                    android:text="@string/tab_home" />

                <TextView
                    android:id="@+id/tabSongs"
                    style="@style/LibraryTab"
                    android:text="@string/tab_songs" />

                <TextView
                    android:id="@+id/tabAlbums"
                    style="@style/LibraryTab"
                    android:text="@string/tab_albums" />

                <TextView
                    android:id="@+id/tabArtists"
                    style="@style/LibraryTab"
                    android:text="@string/tab_artists" />

                <TextView
                    android:id="@+id/tabFolders"
                    style="@style/LibraryTab"
                    android:text="@string/tab_folders" />

                <TextView
                    android:id="@+id/tabPlaylists"
                    style="@style/LibraryTab"
                    android:text="@string/tab_playlists" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/sectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSectionBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="32dp"
                    android:gravity="center_vertical"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReorder"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/playlist_reorder"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/app_text_secondary" />

            <ImageButton
                android:id="@+id/btnLayoutToggle"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/library_view_list"
                android:src="@drawable/ic_view_list"
                app:tint="@color/app_text_secondary" />

            <ImageButton
                android:id="@+id/btnSort"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/library_sort"
                android:src="@drawable/ic_sort"
                app:tint="@color/app_text_secondary" />

            <ImageButton
                android:id="@+id/btnShuffleAll"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/library_shuffle_all"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/btnPlayAll"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button_primary"
                android:contentDescription="@string/library_play_all"
                android:src="@drawable/ic_play"
                app:tint="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/btnPlaylistNew"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/playlist_new"
                android:src="@drawable/ic_add" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/app_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <include
        android:id="@+id/miniPlayer"
        layout="@layout/layout_mini_player" />

    <!-- Actions for the selected songs; shown instead of the mini player. -->
    <LinearLayout
        android:id="@+id/selectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_player"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/actionSelPlay"
            style="@style/SelectionAction"
            android:drawableTop="@drawable/ic_play"
            android:text="@string/action_play" />

        <TextView
            android:id="@+id/actionSelQueue"
            style="@style/SelectionAction"
            android:drawableTop="@drawable/ic_queue_add"
            android:text="@string/cd_queue" />

        <TextView
            android:id="@+id/actionSelPlaylist"
            style="@style/SelectionAction"
            android:drawableTop="@drawable/ic_playlist_add"
            android:text="@string/tab_playlists" />

        <TextView
            android:id="@+id/actionSelFavorite"
            style="@style/SelectionAction"
            android:drawableTop="@drawable/ic_favorite_border"
            android:text="@string/playlist_favorites" />

        <TextView
            android:id="@+id/actionSelDelete"
            style="@style/SelectionAction"
            android:drawableTop="@drawable/ic_delete"
            android:text="@string/action_delete" />

    </LinearLayout>

</LinearLayout>
