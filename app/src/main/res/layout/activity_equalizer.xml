<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvEqMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEq"
                style="@style/SettingsSwitch"
                android:text="@string/eq_enabled" />

            <LinearLayout
                android:id="@+id/eqControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/eq_preset" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        app:singleLine="true"
                        app:singleSelection="true"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/eqBands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvBassTitle"
                    style="@style/SettingsSectionTitle"
                    android:text="@string/eq_bass_boost" />

                <SeekBar
                    android:id="@+id/seekBass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/eq_bass_boost"
                    android:max="1000"
                    android:minHeight="48dp"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btnEqReset"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/eq_reset" />

            </LinearLayout>

            <Button
                android:id="@+id/btnSystemEq"
                style="@style/SecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/eq_system" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/eq_external_hint"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
